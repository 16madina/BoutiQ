{
  "expo": {
    "name": "BoutiQ",
    "slug": "boutiq",
    "scheme": "boutiq",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boutiq.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "BoutiQ utilise vos photos pour rechercher des produits similaires.",
        "NSCameraUsageDescription": "BoutiQ utilise l'appareil photo pour rechercher des produits similaires."
      }
    },
    "android": {
      "package": "com.boutiq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BoutiQ utilise vos photos pour rechercher des produits similaires."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
