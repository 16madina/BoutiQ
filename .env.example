# Copier ce fichier en .env.local et compléter.
# Supabase → projet BoutiQ → Project Settings → API Keys → « Publishable key ».
# Ne JAMAIS mettre la clé service_role dans l'application.
EXPO_PUBLIC_SUPABASE_URL=https://ddfnbjdsszopriydvhaf.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=

# Connexion par SMS réelle : mettre 1 une fois le fournisseur SMS configuré dans
# Supabase (Authentication → Sign In / Providers → Phone). Sinon : mode démo (code 123456).
EXPO_PUBLIC_SMS_AUTH=0

# « Remplir avec l'IA » (facultatif) : adresse d'un service BoutiQ qui garde la clé d'IA.
EXPO_PUBLIC_PRODUCT_ASSISTANT_URL=
